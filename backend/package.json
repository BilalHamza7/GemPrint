{
  "name": "gemprint-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.16.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@types/pdfkit": "0.17.6",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "pdfkit": "0.17.2",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.3",
    "prettier": "^3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
