# Runtime
NODE_ENV=development
PORT=4000

# CORS: use exact browser origins, without trailing slashes.
FRONTEND_URL=http://localhost:5173
# Optional comma-separated trusted browser origins, for example: http://localhost:5174
ADDITIONAL_ALLOWED_ORIGINS=

# Supabase: use the project base URL, not its /rest/v1 endpoint.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only service-role key. Never expose this value to the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# CV engine: use the same randomly generated key in ../cv-service/.env.
CV_SERVICE_URL=http://localhost:8000
CV_INTERNAL_SERVICE_KEY=replace-with-a-32-byte-random-secret

# Generate a unique high-entropy signing secret for API sessions.
JWT_SECRET=replace-with-a-different-32-byte-random-secret
